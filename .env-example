# Run make init to create .env with fresh random credentials.
# Default is Docker on localhost over HTTP. See docs/production.md for HTTPS.
DJANGO_SETTINGS_MODULE=core.settings.development
DEBUG=0
SECRET_KEY=CHANGE_ME_SECRET_KEY
ALLOWED_HOSTS=localhost,127.0.0.1
PUBLIC_BASE_URL=http://localhost:8001
APP_PORT=8001

POSTGRES_DB=boilerplate
POSTGRES_USER=boilerplate
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
DATABASE_URL=postgresql://boilerplate:CHANGE_ME_POSTGRES_PASSWORD@db:5432/boilerplate
REDIS_URL=redis://redis:6379/1
RATE_LIMIT_REDIS_URL=redis://redis:6379/2
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_TASK_ALWAYS_EAGER=0

RATE_ANON=60/minute
RATE_USER=600/minute
RATE_LOGIN=5/minute
RATE_REGISTER=5/hour
RATE_PASSWORD_RESET=5/hour
RATE_PASSWORD_RESET_CONFIRM=10/minute
# Only set exact trusted proxy peer IPs; proxy must overwrite X-Real-IP.
TRUSTED_PROXY_IPS=
TRUST_PROXY_HTTPS=0
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=noreply@localhost

USE_S3=0
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=us-east-1
AWS_S3_ENDPOINT_URL=
# Prefer workload IAM credentials in production.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_PASSWORD
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
